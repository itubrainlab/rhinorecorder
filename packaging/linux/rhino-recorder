#!/bin/sh
# Start Rhino Recorder from its unpacked (or installed) folder.
#
# The folder carries its own Python and RhinoRecorder, but not g.Pype or
# g.tec's gtec-unicorn driver: their g.tec Non-Commercial Licenses do not
# allow them to be redistributed in a bundle. On first launch, and after
# an update, bootstrap.py installs them and the other libraries from PyPI into
# ~/.local/share/RhinoRecorder/runtime.
set -u

HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
PYTHON="$HERE/python/bin/python3"
BUILD="$(cat "$HERE/build-id")"
LIB="${XDG_DATA_HOME:-$HOME/.local/share}/RhinoRecorder/runtime/$BUILD"

if [ ! -f "$LIB/.complete" ]; then
    "$PYTHON" -I "$HERE/bootstrap.py" "$HERE" "$LIB" || exit 1
fi

# -I: ignore the environment and the user's site-packages; the libraries
# come from $LIB alone.
exec "$PYTHON" -I -c '
import sys
sys.path.insert(0, sys.argv.pop(1))
sys.argv[0] = "rhino-recorder"
from rhinorecorder.app import main
sys.exit(main())
' "$LIB" "$@"
