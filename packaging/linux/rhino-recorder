#!/bin/sh
# Start Rhino Recorder from its unpacked (or installed) folder.
#
# The folder carries its own Python, RhinoRecorder and gpype-rhino, but
# not g.Pype: the g.tec Non-Commercial License does not allow g.Pype to
# be redistributed in a bundle. On first launch, and after an update,
# bootstrap.py installs g.Pype and the other libraries from PyPI into
# ~/.local/share/RhinoRecorder/runtime.
set -u

HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
PYTHON="$HERE/python/bin/python3"
BUILD="$(cat "$HERE/build-id")"
LIB="${XDG_DATA_HOME:-$HOME/.local/share}/RhinoRecorder/runtime/$BUILD"

if [ ! -f "$LIB/.complete" ]; then
    "$PYTHON" -I "$HERE/bootstrap.py" "$HERE" "$LIB" || exit 1
fi

# -I: ignore the environment and the user's site-packages; the libraries
# come from $LIB alone.
exec "$PYTHON" -I -c '
import sys
sys.path.insert(0, sys.argv.pop(1))
sys.argv[0] = "rhino-recorder"
from rhino_recorder.app import main
sys.exit(main())
' "$LIB" "$@"
